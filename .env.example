# Super Agent X: every value is optional. With nothing set it runs on the local
# fallbacks (espeak-ng voice, FFmpeg motion, template story) and tells you what is missing.
# Never commit your real .env.

# ---- Server -------------------------------------------------------------
# SAX_API_HOST=127.0.0.1      # a non-loopback host REQUIRES SAX_API_TOKEN
# SAX_API_PORT=8765
# SAX_API_TOKEN=              # openssl rand -hex 32
# SAX_APPROVAL_MODE=queue     # queue | deny | auto (auto is not recommended)
# SAX_DATABASE_URL=           # default: SQLite in SAX_HOME. PostgreSQL: postgresql+asyncpg://user:pass@host/db

# ---- Budgets (USD). Paid calls over a budget wait for your approval -----
# SAX_DAILY_BUDGET_USD=5
# SAX_PROJECT_BUDGET_USD=20
# SAX_PER_GENERATION_BUDGET_USD=2

# ---- Language models (any one is enough) --------------------------------
# OLLAMA_BASE_URL=http://127.0.0.1:11434      # local, free
# OPENAI_API_KEY=                             # also works for OmniRoute / FreeLLMAPI / LM Studio via OPENAI_BASE_URL
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# BEDROCK_MODEL_ID=

# ---- Image / video generation (optional) --------------------------------
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# REPLICATE_API_TOKEN=
# FAL_KEY=

# ---- Voice / search (optional) ------------------------------------------
# PIPER_BIN=
# PIPER_MODEL=
# SEARXNG_URL=
